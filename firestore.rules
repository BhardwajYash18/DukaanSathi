rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Connection tests
    match /connection_tests/{docId} {
      allow read, write: if request.time < timestamp.date(2026, 11, 1);
    }

    // 2. DukaanSathi Customers & Khata records
    match /customers/{customerId} {
      allow read, write: if request.time < timestamp.date(2026, 11, 1);
    }

    // 3. DukaanSathi Products & Inventory stock
    match /products/{productId} {
      allow read, write: if request.time < timestamp.date(2026, 11, 1);
    }

    // 4. DukaanSathi Sales transactions (Cash & Udhar)
    match /sales/{saleId} {
      allow read, write: if request.time < timestamp.date(2026, 11, 1);
    }

    // 5. DukaanSathi Khata Repayments (Jama)
    match /repayments/{repaymentId} {
      allow read, write: if request.time < timestamp.date(2026, 11, 1);
    }
  }
}
